<mxfile host="app.diagrams.net"><diagram name="scenarios"><mxGraphModel pageWidth="960" pageHeight="455"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="original" value="Original baseline&#10;West B2B OFF; east B2B OFF&#10;West: 0; east: 0 lab prefixes&#10;8 sessions established&#10;Receiver expectation FAILED" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="80" width="280" height="145" /></mxCell><mxCell id="control" value="West-only diagnostic&#10;West B2B ON; east B2B OFF&#10;West: 2; east: 0 lab prefixes&#10;Both endpoints match&#10;Original west setting restored" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="80" width="280" height="145" /></mxCell><mxCell id="revised" value="Revised baseline: both B2B ON&#10;West: 2; east: 2 lab prefixes&#10;West filter: 1; east stays 2&#10;West withdrawal: 0; east stays 2&#10;West restoration: 2; east stays 2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="80" width="280" height="145" /></mxCell><mxCell id="limits" value="Revised four-scenario matrix VERIFIED&#10;8 sessions and per-neighbor provenance checked at each phase&#10;VNet advertisements remain during lab-prefix withdrawal&#10;Flags restored; packet delivery and ECMP NOT assessed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="290" width="600" height="125" /></mxCell></root></mxGraphModel></diagram></mxfile>